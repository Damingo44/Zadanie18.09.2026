<%- include('partials/header') %>

<h1>WITAJ! o to todolist</h1>

    <h2>Dodaj opcję</h2>

    <input type="text" placeholder="Nazwa" id="Nazwa">
    <input type="text" placeholder="Opis" id="Opis">

    <button type="button" onclick="Tak()">Wyślij</button

<ul id="tab">
</ul>

<button type="button" onclick="Nie()">Wyczyść</button>

<script>
    function Tak() {
        const nazwa = document.getElementById("Nazwa").value;
        const opis = document.getElementById("Opis").value;

        const element = document.createElement("li");
        element.textContent = nazwa + " - " + opis;

        document.getElementById("tab").appendChild(element);

        document.getElementById("Nazwa").value = "";
        document.getElementById("Opis").value = "";
    }

    function Nie() {
        document.getElementById("tab").innerHTML = "";
    }
</script>

